{
  "mcpServers": {
    "dbt": {
      "command": "uvx",
      "args": ["dbt-mcp"],
      "env": {
        "DBT_PROJECT_DIR": "${CLAUDE_PROJECT_DIR}",
        "DBT_PATH": "${CLAUDE_PROJECT_DIR}/venv/bin/dbt",
        "DISABLE_SEMANTIC_LAYER": "true",
        "DISABLE_DISCOVERY": "true",
        "DISABLE_ADMIN_API": "true"
      }
    }
  }
}